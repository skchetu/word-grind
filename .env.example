# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic: console.anthropic.com → API keys. Server-side only.
ANTHROPIC_API_KEY=

# ElevenLabs: elevenlabs.io → Developers → API Keys (Text to Speech
# only). Server-side only. Leave blank to use the browser voice.
ELEVENLABS_API_KEY=
# Voices → pick one → copy its Voice ID.
ELEVENLABS_VOICE_ID=

# Sentry: only used on Vercel; leave blank locally. Project settings →
# Client Keys (DSN). The auth token (Settings → Auth Tokens) uploads source
# maps at build time and stays server-side.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
