# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic: console.anthropic.com → API keys. Server-side only.
ANTHROPIC_API_KEY=

# ElevenLabs: elevenlabs.io → Developers → API Keys (Text to Speech
# only). Server-side only. Leave blank to use the browser voice.
ELEVENLABS_API_KEY=
# Voices → pick one → copy its Voice ID.
ELEVENLABS_VOICE_ID=
