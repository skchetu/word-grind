# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Day 1, PR 4): Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic (Day 3): console.anthropic.com → API keys. Server-side only.
ANTHROPIC_API_KEY=

# ElevenLabs (Day 5): elevenlabs.io → Developers → API Keys (Text to Speech
# only). Server-side only. Leave blank to use the browser voice.
ELEVENLABS_API_KEY=
# Voices → pick one → copy its Voice ID.
ELEVENLABS_VOICE_ID=
